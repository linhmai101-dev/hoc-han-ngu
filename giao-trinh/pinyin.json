{"app": "hanngu", "v": 2, "curriculum": "pinyin", "title": "Nhập môn phát âm pinyin", "version": 1, "lessons": [{"id": "gtc-pinyin-01", "kind": "book", "curriculum": "pinyin", "order": 1, "level": 0, "title": "Phát âm 1: Thanh điệu", "source": "Nhập môn phát âm pinyin", "intro_vi": "Bốn thanh và thanh nhẹ — Nghe và đọc đúng 4 thanh của tiếng Phổ thông. Cùng một âm, đổi thanh là đổi nghĩa.", "vocab": [{"hz": "妈", "py": "mā", "vi": "mẹ (thanh 1)"}, {"hz": "麻", "py": "má", "vi": "tê, vừng (thanh 2)"}, {"hz": "马", "py": "mǎ", "vi": "ngựa (thanh 3)"}, {"hz": "骂", "py": "mà", "vi": "mắng (thanh 4)"}, {"hz": "吗", "py": "ma", "vi": "không? (thanh nhẹ)"}, {"hz": "八", "py": "bā", "vi": "tám"}, {"hz": "拔", "py": "bá", "vi": "nhổ"}, {"hz": "把", "py": "bǎ", "vi": "cầm, cái"}, {"hz": "爸", "py": "bà", "vi": "bố"}, {"hz": "衣", "py": "yī", "vi": "áo"}, {"hz": "姨", "py": "yí", "vi": "dì"}, {"hz": "椅", "py": "yǐ", "vi": "ghế"}, {"hz": "意", "py": "yì", "vi": "ý"}], "grammar": [{"pattern": "Thanh 1 (ˉ) – cao và bằng", "vi": "Giọng cao, giữ nguyên độ cao từ đầu đến cuối, như ngân một nốt nhạc cao. Người Việt hay đọc thấp như thanh ngang, cần nâng giọng lên cao hơn giọng nói thường.", "example_hz": "妈", "example_py": "mā", "example_vi": "mẹ"}, {"pattern": "Thanh 2 (ˊ) – đi lên", "vi": "Từ giữa lên cao, giống dấu sắc nhưng kéo dài và đều, không gắt. Mẹo: như khi hỏi lại \"Hả?\" đầy ngạc nhiên.", "example_hz": "麻", "example_py": "má", "example_vi": "tê"}, {"pattern": "Thanh 3 (ˇ) – xuống thấp rồi lên", "vi": "Hạ giọng xuống rất thấp rồi mới hơi lên, gần dấu hỏi nhưng trầm hơn. Khi đứng trước âm khác, thường chỉ đọc nửa đầu: hạ thấp và giữ.", "example_hz": "马", "example_py": "mǎ", "example_vi": "ngựa"}, {"pattern": "Thanh 4 (ˋ) – rơi mạnh", "vi": "Bắt đầu từ cao rồi rơi nhanh, dứt khoát, như khi quát \"Đi!\". KHÔNG giống dấu huyền: dấu huyền thấp và bằng, còn thanh 4 bắt đầu cao.", "example_hz": "骂", "example_py": "mà", "example_vi": "mắng"}, {"pattern": "Thanh nhẹ – không dấu", "vi": "Đọc n