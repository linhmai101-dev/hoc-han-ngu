, "example_py": "zì cì sì", "example_vi": "chữ / lần / bốn", "place": "rang"}, {"pattern": "Âm uốn lưỡi (đầu lưỡi sau): zh ch sh r", "vi": "Cong đầu lưỡi lên, chạm phần trước của vòm cứng (phía sau lợi). Môi hơi tròn và đẩy ra. Mẹo: nói \"s\" rồi từ từ cong lưỡi về sau.", "example_hz": "中 / 吃 / 是 / 热", "example_py": "zhōng chī shì rè", "example_vi": "giữa / ăn / là / nóng", "place": "uon"}, {"pattern": "Âm mặt lưỡi: j q x", "vi": "Đầu lưỡi tì vào chân răng cửa dưới, mặt lưỡi (phần giữa) nâng lên áp vào vòm cứng. Môi dẹt như đang cười.", "example_hz": "鸡 / 七 / 西", "example_py": "jī qī xī", "example_vi": "gà / bảy / tây", "place": "mat"}, {"pattern": "Âm cuống lưỡi (vòm mềm): g k h", "vi": "Cuống lưỡi (phần sau cùng) nâng lên chạm vòm mềm ở sâu trong họng. g như \"c\", k bật hơi, h ma sát ở đây nên nghe giống \"kh\".", "example_hz": "哥 / 渴 / 喝", "example_py": "gē kě hē", "example_vi": "anh / khát / uống", "place": "cuong"}, {"pattern": "Bật hơi và không bật hơi", "vi": "Sáu cặp: b/p, d/t, g/k, z/c, zh/ch, j/q. Âm thứ hai luôn bật một luồng hơi mạnh. Thử: để bàn tay trước miệng, đọc p, t, k, c, ch, q phải thấy hơi phả vào tay; đọc b, d, g, z, zh, j thì gần như không thấy.", "example_hz": "爸 / 怕", "example_py": "bà pà", "example_vi": "bố / sợ"}], "sentences": [{"who": "", "hz": "爸爸", "py": "bà ba", "vi": "bố"}, {"who": "", "hz": "怕", "py": "pà", "vi": "sợ"}, {"who": "", "hz": "大", "py": "dà", "vi": "to"}, {"who": "", "hz": "他", "py": "tā", "vi": "anh ấy"}, {"who": "", "hz": "字", "py": "zì", "vi": "chữ"}, {"who": "", "hz": "中国", "py": "zhōng guó", "vi": "Trung Quốc"}, {"who": "", "hz": "鸡", "py": "jī", "vi": "gà"}, {"who": "", "hz": "哥哥", "py": "gē ge", "vi": "anh trai"}], "exercises": [{"type": "mc", "q": "Âm j, q, x đặt phần nào của lưỡi?", "options": ["Mặt lưỡi áp vòm cứng", "Cuống lưỡi", "Đầu lưỡi cong lên", "Hai môi"], "answer": 0, "explain_vi": ""}, {"type": "mc", "q": "Âm nào là âm cuống lưỡi?", "options": ["g, k, h", "z, c, s", "j, q, x", "b, p, m"], "answer": 0,