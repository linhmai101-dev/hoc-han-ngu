{"app": "hanngu", "v": 2, "curriculum": "botho", "title": "Bộ thủ cơ bản", "version": 1, "lessons": [{"id": "gtc-botho-01", "kind": "book", "curriculum": "botho", "order": 1, "level": 0.5, "title": "Bộ thủ 1: con người và cơ thể", "source": "Bộ thủ cơ bản", "intro_vi": "Người, miệng, tay, tim, chân… — Bộ thủ là phần gợi nghĩa của chữ. Nhận ra bộ thủ giúp đoán nghĩa và nhớ chữ nhanh hơn rất nhiều.", "vocab": [{"hz": "你", "py": "nǐ", "vi": "bạn (bộ 亻)"}, {"hz": "他", "py": "tā", "vi": "anh ấy (bộ 亻)"}, {"hz": "吃", "py": "chī", "vi": "ăn (bộ 口)"}, {"hz": "叫", "py": "jiào", "vi": "gọi (bộ 口)"}, {"hz": "打", "py": "dǎ", "vi": "đánh (bộ 扌)"}, {"hz": "找", "py": "zhǎo", "vi": "tìm (bộ 扌)"}, {"hz": "妈", "py": "mā", "vi": "mẹ (bộ 女)"}, {"hz": "好", "py": "hǎo", "vi": "tốt (bộ 女)"}, {"hz": "想", "py": "xiǎng", "vi": "nghĩ (bộ 心)"}, {"hz": "忙", "py": "máng", "vi": "bận (bộ 忄)"}, {"hz": "看", "py": "kàn", "vi": "nhìn (bộ 目)"}, {"hz": "跑", "py": "pǎo", "vi": "chạy (bộ 足)"}, {"hz": "说", "py": "shuō", "vi": "nói (bộ 讠)"}, {"hz": "脸", "py": "liǎn", "vi": "mặt (bộ 月)"}, {"hz": "字", "py": "zì", "vi": "chữ (bộ 子)"}, {"hz": "男", "py": "nán", "vi": "nam (bộ 力)"}], "grammar": [{"pattern": "亻 (人)  rén · bộ Nhân", "vi": "Người. Đứng bên trái gọi là \"nhân đứng\". Chữ có bộ này thường liên quan đến con người.", "example_hz": "你 / 他 / 们", "example_py": "nǐ tā men", "example_vi": "bạn / anh ấy / (số nhiều)"}, {"pattern": "口  kǒu · bộ Khẩu", "vi": "Miệng. Liên quan đến ăn, uống, nói, kêu.", "example_hz": "吃 / 喝 / 叫", "example_py": "chī hē jiào", "example_vi": "ăn / uống / gọi"}, {"pattern": "扌 (手)  shǒu · bộ Thủ", "vi": "Tay. Bên trái gọi là \"tay gẩy\". Chữ chỉ động tác bằng tay.", "example_hz": "打 / 找 / 拿", "example_py": "dǎ zhǎo ná", "example_vi": "đánh / tìm / cầm"}, {"pattern": "女  nǚ · bộ Nữ", "vi": "Phụ nữ. Chữ về người nữ, quan hệ gia đình.", "example_hz": "妈 / 姐 / 好", "example_py": "mā jiě hǎo", "example_vi": "mẹ / chị / tốt"}, {"pattern": "子  zǐ · bộ Tử", "vi": "Con, đứa trẻ.", "example_hz": "字 / 孩 / 学", "example_py": "zì hái xué", "example_vi": "chữ / trẻ con / học"}, {"pattern": "心 / 忄  xīn · bộ Tâm", "vi": "Tim, tình cảm, suy nghĩ. Đứng bên trái viết thành 忄 (\"tâm đứng\").", "example_hz": "想 / 忙 / 快", "example_py": "xiǎng máng kuài", "example_vi": "nghĩ / bận / nhanh"}, {"pattern": "目  mù · bộ Mục", "vi": "Mắt, nhìn.", "example_hz": "看 / 眼 / 睛", "example_py": "kàn yǎn jīng", "example_vi": "nhìn / mắt / tròng mắt"}, {"pattern": "耳  ěr · bộ Nhĩ", "vi": "Tai, nghe.", "example_hz": "聊 / 取 / 职", "example_py": "liáo qǔ zhí", "example_vi": "trò chuyện / lấy / chức"}, {"pattern": "⻊ (足)  zú · bộ Túc", "vi": "Chân, đi lại.", "example_hz": "跑 / 跳 / 路", "example_py": "pǎo tiào lù", "example_vi": "chạy / nhảy / đường"}, {"pattern": "讠 (言)  yán · bộ Ngôn", "vi": "Lời nói. Chữ liên quan đến nói, ngôn ngữ.", "example_hz": "说 / 话 / 请", "example_py": "shuō huà qǐng", "example_vi": "nói / lời / mời"}, {"pattern": "月 (肉)  ròu · bộ Nhục / Nguyệt", "vi": "Đứng bên trái thường là \"thịt\", chỉ bộ phận cơ thể; đứng riêng là mặt trăng.", "example_hz": "脸 / 肚 / 脚", "example_py": "liǎn dù jiǎo", "example_vi": "mặt / bụng / bàn chân"}, {"pattern": "力  lì · bộ Lực", "vi": "Sức lực.", "example_hz": "男 / 动 / 办", "example_py": "nán dòng bàn", "example_vi": "nam / động / làm"}], "sentences": [{"who": "", "hz": "你们", "py": "nǐ men", "vi": "các bạn"}, {"who": "", "hz": "吃饭", "py": "chī fàn", "vi": "ăn cơm"}, {"who": "", "hz": "打电话", "py": "dǎ diàn huà", "vi": "gọi điện"}, {"who": "", "hz": "妈妈", "py": "mā ma", "vi": "mẹ"}, {"who": "", "hz": "想家", "py": "xiǎng jiā", "vi": "nhớ nhà"}, {"who": "", "hz": "看书", "py": "kàn shū", "vi": "đọc sách"}, {"who": "", "hz": "跑步", "py": "pǎo bù", "vi": "chạy bộ"}, {"who": "", "hz": "说话", "py": "shuō huà", "vi": "nói chuyện"}], "exercises": [{"type": "mc", "q": "Chữ 喝 (uống) có bộ gì?", "options": ["口 khẩu – miệng", "氵 thủy", "亻 nhân", "扌 thủ"], "answer": 0, "explain_vi": ""}, {"type": "mc", "q": "Bộ 亻 có nghĩa là?", "options": ["người", "tay", "